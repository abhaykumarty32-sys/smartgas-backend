# ==============================================================================
# Smart Gas Monitoring Backend - Environment Configuration
# ==============================================================================

PORT=5050
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartgas?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_PORT=1883

# ------------------------------------------------------------------------------
# Redis Cloud / Cache (Optional - falls back to in-memory + MongoDB if unset)
# ------------------------------------------------------------------------------
REDIS_URL=redis://default:<password>@<host>:<port>

# ------------------------------------------------------------------------------
# Email Delivery Service (CRITICAL FOR RENDER DEPLOYMENT)
# ------------------------------------------------------------------------------
# Render's Free tier blocks outbound SMTP ports 25, 465, and 587.
# For 100% reliable OTP delivery on Render, use Resend HTTPS API (free tier: 3000 emails/mo):
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Smart Gas Monitoring <onboarding@resend.dev>

# Optional SMTP fallback (Works locally, but blocked on Render Free tier):
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Authentication & Password Reset Synchronization)
# ------------------------------------------------------------------------------
# Set on Render Web Service -> Environment:
FIREBASE_PROJECT_ID=smart-gas-monitoring-96c0a
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@smart-gas-monitoring-96c0a.iam.gserviceaccount.com
# Paste the full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OR provide the entire service account JSON as a string or base64:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"smart-gas-monitoring-96c0a",...}

